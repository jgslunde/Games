{
  "name": "copenhagen: line_10x64_gpool + reach planes + defender-region plane (the encirclement test)",
  "game": {
    "ruleset": "copenhagen",
    "max_game_length": 300
  },
  "network": {
    "channels": 64,
    "blocks": [
      "line",
      "line",
      "line",
      "line",
      "line",
      "line",
      "line",
      "line",
      "line",
      "line"
    ],
    "bottleneck": 0.5,
    "squeeze_excitation": false,
    "global_pool": "every_other",
    "global_pool_channels": 16,
    "tie_blocks": false,
    "attention_heads": 4,
    "policy_head": "conv",
    "policy_dense_channels": 2,
    "policy_bilinear_dim": 32,
    "value_head": "pooled",
    "value_hidden": 128,
    "value_pool_channels": 16,
    "features": {
      "history_length": 1,
      "constant_planes": true,
      "mobility_planes": true,
      "region_plane": true
    }
  },
  "self_play": {
    "num_iterations": 400,
    "num_games_per_iteration": 256,
    "num_mcts_sims_attacker": 400,
    "num_mcts_sims_defender": 400,
    "c_puct": 2.0,
    "fpu_reduction": 0.0,
    "search_discount": 0.995,
    "temperature": 1.0,
    "temperature_mode": "decay",
    "temperature_threshold": 10,
    "temperature_decay_moves": 40,
    "add_dirichlet_noise": true,
    "dirichlet_alpha": 0.1,
    "dirichlet_epsilon": 0.35,
    "use_random_opening_moves": true,
    "use_dynamic_sim_balancing": true,
    "dynamic_sim_adjustment_rate": 0.2,
    "dynamic_sim_min_win_rate": 0.2,
    "reward_discount": 0.995,
    "track_unique_states": true
  },
  "training": {
    "batch_size": 256,
    "num_epochs": 10,
    "batches_per_epoch": 200,
    "learning_rate": 0.001,
    "lr_decay": 0.99,
    "lr_floor": 3e-05,
    "use_stepping_lr": true,
    "lr_step_iterations": [
      100,
      200,
      300
    ],
    "lr_step_values": [
      0.001,
      0.0005,
      0.0001,
      1e-05
    ],
    "weight_decay": 0.01,
    "value_loss_weight": 1.5,
    "use_dynamic_boosting": false,
    "dynamic_boost_alpha": 0.1,
    "dynamic_boost_min": 0.2,
    "dynamic_boost_max": 5.0,
    "attacker_win_loss_boost": 1.0,
    "draw_penalty_attacker": 0.0,
    "draw_penalty_defender": 0.0
  },
  "replay_buffer": {
    "replay_buffer_size": 12000000,
    "min_buffer_size": 400000,
    "use_data_augmentation": true
  },
  "evaluation": {
    "eval_games": 128,
    "eval_win_rate": 0.6,
    "eval_frequency": 4,
    "eval_mcts_sims_attacker": 400,
    "eval_mcts_sims_defender": 400,
    "eval_c_puct": 1.5,
    "eval_fpu_reduction": -0.25,
    "eval_temperature": 1.0,
    "eval_temperature_mode": "fixed",
    "eval_temperature_threshold": 20,
    "eval_temperature_decay_moves": 20,
    "eval_vs_random_games": 64,
    "eval_vs_random_frequency": 9999999
  },
  "system": {
    "num_workers": null,
    "device": "cpu",
    "temp_dir": "/dev/shm/",
    "checkpoint_dir": "checkpoints/copenhagen/line_10x64_gpool_mobility_region",
    "save_frequency": 1,
    "log_frequency": 1,
    "verbose": true
  }
}
